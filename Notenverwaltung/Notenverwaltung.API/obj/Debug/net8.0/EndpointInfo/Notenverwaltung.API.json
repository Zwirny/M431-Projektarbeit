          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/AuthReciveDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthReciveDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthReciveDto"
                }
              }
            }
          }
        }
      }
    },
