  "components": {
    "schemas": {
      "AuthReciveDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "nullable": true
          },
          "passwort": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PostGradeDto": {
        "required": [
          "courseId",
          "grade",
          "studentFirstName",
          "studentLastName"
        ],
        "type": "object",
        "properties": {
          "studentFirstName": {
            "minLength": 1,
            "type": "string"
          },
          "studentLastName": {
            "minLength": 1,
            "type": "string"
          },
          "courseId": {
            "type": "integer",
            "format": "int32"
          },
          "grade": {
            "maximum": 6,
            "minimum": 1,
            "type": "number",
            "format": "float"
          },
          "notice": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PutGradeDto": {
        "required": [
          "courseId",
          "grade",
          "studentFirstName",
          "studentLastName"
        ],
        "type": "object",
        "properties": {
          "studentFirstName": {
            "minLength": 1,
            "type": "string"
          },
          "studentLastName": {
            "minLength": 1,
            "type": "string"
          },
          "grade": {
            "maximum": 6,
            "minimum": 1,
            "type": "number",
            "format": "float"
          },
          "notice": {
            "type": "string",
            "nullable": true
          },
          "courseId": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "vorname": {
            "type": "string",
            "nullable": true
          },
          "nachname": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "passwort": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "JWT Authorization header using the Bearer scheme. Enter 'Bearer {token}'",
        "scheme": "Bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ]
}