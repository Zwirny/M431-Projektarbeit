                "$ref": "#/components/schemas/LoginDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/AuthReciveDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthReciveDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthReciveDto"
                }
              }
            }
          }
        }
      }
