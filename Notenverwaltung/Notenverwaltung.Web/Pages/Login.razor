@page "/"

<PageTitle>Login</PageTitle>

<div class="d-flex flex-column align-items-center">
    <h1 class="mb-5">Login</h1>

    <!-- Email and password input -->
    <EditForm Model="@loginModel" OnValidSubmit="HandleLogin" class="d-flex flex-column">
        <InputText @bind-Value="loginModel.Email" class="mb-4"/>
        <InputText @bind-Value="loginModel.Password" type="password" class="mb-4" />
        <button type="submit" class="btn btn-dark ms-3">Login</button>
    </EditForm>
</div>