@page "/Verwaltung"

<!-- Dropdown for the class -->
<div class="form-floating">
    <select class="form-select" id="floatingSelect" aria-label="Floating label select example">
        <option selected>Wählen Sie eine Klasse</option>
        <option value="1">One</option>
        <option value="2">Two</option>
        <option value="3">Three</option>
    </select>
    <label for="floatingSelect">Klasse</label>
</div>

<!-- Dropdown for the student -->
<div class="form-floating">
    <select class="form-select" id="floatingSelect" aria-label="Floating label select example">
        <option selected>Wählen Sie einen Schüler</option>
        <option value="1">One</option>
        <option value="2">Two</option>
        <option value="3">Three</option>
    </select>
    <label for="floatingSelect">Schüler</label>
</div>

<!-- Input for the examgrade -->
<div class="form-floating mb-3">
    <input type="text" class="form-control" id="floatingInput" placeholder="1 - 6">
    <label for="floatingInput">Aktualisierte Prüfungsnote</label>
</div>


<!-- Input for the Zeugnisnote -->
<div class="form-floating mb-3">
    <input type="text" class="form-control" id="floatingInput" placeholder="1 - 6">
    <label for="floatingInput">Aktualisierte Zeugnisnote</label>
</div>

<!-- Submit-Button -->
<button class="btn btn-dark">Submit</button>