@page "/Verwaltung"

<div class="d-flex justify-content-center">
    <div class="d-flex flex-column w-25 justify-content-center">

        <!-- Input for the student -->
        <div class="form-floating mb-4">
            <input type="text" class="form-control" id="StudentInput" placeholder="Max Mustermann" @bind-value="student">
            <label for="floatingInput">Vor- & Nachname des Schülers</label>
        </div>

        <!-- Input for the examgrade -->
        <div class="form-floating mb-4">
            <input type="number" class="form-control" id="ExamInput" placeholder="1 - 6" @bind-value="examGrade">
            <label for="floatingInput">Neue Prüfungsnote</label>
        </div>

        <!-- Input for the course -->
        <div class="form-floating mb-4">
            <input type="text" class="form-control" id="CourseInput" placeholder="Deutsch" @bind-value="course">
            <label for="floatingInput">Fach der Note</label>
        </div>

        <!-- Input for the notice -->
        <div class="form-floating mb-4">
            <input type="text" class="form-control" id="CourseInput" placeholder="War sehr gut" @bind-value="notice">
            <label for="floatingInput">Bemerkung</label>
        </div>

        <!-- Submit-Button -->
        <button class="btn btn-dark w-50 mx-auto d-block" @onclick="SendGrade">Mail senden</button>
    </div>

    <NavLink href="/admin/register" class="btn btn-primary">
        Benutzer registrieren
    </NavLink>

</div>
