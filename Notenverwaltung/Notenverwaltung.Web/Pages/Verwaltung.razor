@page "/Verwaltung"
@using Notenverwaltung.Shared.Dtos.CourseDtos

<div class="d-flex justify-content-center m-4">
    <h2>Noten Verwaltung</h2>
</div>

<div class="d-flex justify-content-center">
    <EditForm Model="@gradeModel" OnValidSubmit="SendGrade" class="d-flex flex-column w-25">
        <DataAnnotationsValidator />
        <!-- Vorname -->
        <div class="form-floating mb-4">
            <InputText class="form-control" id="FirstName"
                       @bind-Value="gradeModel.StudentFirstName"
                       placeholder="Max" />
            <label for="FirstName">Vorname des Schülers</label>
            <ValidationMessage For="@(() => gradeModel.StudentFirstName)" />
        </div>

        <!-- Nachname -->
        <div class="form-floating mb-4">
            <InputText class="form-control" id="LastName"
                       @bind-Value="gradeModel.StudentLastName"
                       placeholder="Mustermann" />
            <label for="LastName">Nachname des Schülers</label>
            <ValidationMessage For="@(() => gradeModel.StudentLastName)" />
        </div>

        <!-- Note -->
        <div class="form-floating mb-4">
            <InputNumber class="form-control" id="ExamGrade"
                         @bind-Value="gradeModel.Grade"
                         placeholder="1 - 6" />
            <label for="ExamGrade">Neue Prüfungsnote</label>
            <ValidationMessage For="@(() => gradeModel.Grade)" />
        </div>

        <!-- Fach -->
        <div class="form-floating mb-4">
            <select class="form-select" id="CourseId" @bind="courseId">
                @foreach (CourseDto course in courses)
                {
                    <option value="@course.Id">@course.KursName</option>
                }
            </select>
            <label for="CourseId">Fach</label>
        </div>



        <!-- Bemerkung -->
        <div class="form-floating mb-4">
            <InputText class="form-control" id="Notice"
                       @bind-Value="gradeModel.Notice"
                       placeholder="War sehr gut" />
            <label for="Notice">Bemerkung</label>
        </div>

        <ValidationSummary />

        <button type="submit" class="btn btn-dark w-50 mx-auto">
            Submit
        </button>

    </EditForm>

</div>

<div class="d-flex justify-content-center m-2">
    @if (isSuccess == 1)
    {
        <div class="alert alert-success mt-3" role="alert">
            Die Note wurde erfolgreich gesendet!
        </div>
    }
    @if (isSuccess == 2)
    {
        <div class="alert alert-danger mt-3" role="alert">
            Beim Senden der Note ist ein Fehler aufgetreten. Bitte versuchen Sie es später erneut.
        </div>
    }
</div>


<div class="d-flex justify-content-center m-2">
    <NavLink href="/admin/register" class="btn btn-primary ms-3">
        Benutzer registrieren
    </NavLink>
</div>
